<div
    class="modal fade"
    id="lkncielo3ds-modal"
    data-keyboard="true"
    tabindex="-1"
    aria-labelledby="staticBackdropLabel"
    aria-hidden="true"
>
    <div
        class="modal-dialog modal-sm"
        style="max-width: 500px;"
    >
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="lkncielo3ds-modal-title"></span>
                </h5>
            </div>
            <div class="modal-body">
                <p
                    id="lkncielo3ds-modal-body"
                    style="text-align: left;"
                ></p>
                <small id="lkncielo3ds-modal-small"></small>
            </div>
            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-dismiss="modal"
                >Fechar</button>
            </div>
        </div>
    </div>
</div>

<div
    id="lkncielo3ds-toast"
    class="toast"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
    data-delay="3000"
    data-animation="true"
    style="position: fixed; bottom: 20px; right: 30px; z-index: 999;"
>
    <div class="toast-header">
        <svg
            class="bd-placeholder-img rounded mr-2"
            width="20"
            height="20"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid slice"
            focusable="false"
            role="img"
        >
            <rect
                width="100%"
                height="100%"
                fill="#007aff"
            ></rect>
        </svg>
        <strong
            id="lkncielo3ds-toast-title"
            class="mr-auto"
        >Bootstrap</strong>
        <button
            type="button"
            class="ml-2 mb-1 close"
            data-dismiss="toast"
            aria-label="Close"
        >
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div
        id="lkncielo3ds-toast-body"
        class="toast-body"
    ></div>
</div>
